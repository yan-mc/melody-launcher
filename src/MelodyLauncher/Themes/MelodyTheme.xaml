<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 1 physical pixel at 175% DPI -->
    <sys:Double x:Key="Px1">0.5714285714285714</sys:Double>

    <!-- colors / brushes -->
    <LinearGradientBrush x:Key="BtnFillBig" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#E2DDE4E7" Offset="0" />
        <GradientStop Color="#F6E1E7E8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BtnFillSmall"   Color="#E7DDE4E7" />
    <SolidColorBrush x:Key="BtnFillHover"   Color="#F0EDF1F2" />
    <SolidColorBrush x:Key="BtnStroke"      Color="#CF7C8C95" />
    <SolidColorBrush x:Key="BtnInnerHi"     Color="#D1D6D8D9" />
    <SolidColorBrush x:Key="BtnInnerBottom" Color="#F7E6EBEE" />
    <SolidColorBrush x:Key="BtnOuterDark"   Color="#A343697E" />

    <SolidColorBrush x:Key="TextBig"     Color="#232628" />
    <SolidColorBrush x:Key="TextSmall"   Color="#333536" />
    <SolidColorBrush x:Key="TextCredit"  Color="#BEBEBF" />
    <SolidColorBrush x:Key="White89"     Color="#E3FFFFFF" />
    <SolidColorBrush x:Key="White90"     Color="#E6FFFFFF" />

    <SolidColorBrush x:Key="ComboFill"    Color="#E7F5F7F8" />
    <SolidColorBrush x:Key="ComboStroke"  Color="#FF3C9CE3" />
    <SolidColorBrush x:Key="ChevronColor" Color="#FF254A69" />

    <SolidColorBrush x:Key="OverlayVeilTop"    Color="#9474C2E5" />
    <SolidColorBrush x:Key="OverlayVeilBottom" Color="#94A6DAEF" />

    <FontFamily x:Key="UiFont">Microsoft YaHei</FontFamily>
    <FontFamily x:Key="SerifFont">SimSun</FontFamily>

    <!-- classic button template (multi-layer stroke + shadow) -->
    <Style x:Key="MelodyButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource BtnFillSmall}" />
        <Setter Property="BorderBrush" Value="{StaticResource BtnStroke}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#FF000000" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border CornerRadius="0.5714" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BtnOuterDark}" BorderThickness="0.5714">
                            <Grid>
                                <Border CornerRadius="0.5714" Margin="0.5714"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.5714" />
                                <Border VerticalAlignment="Top" Height="0.5714" Margin="1.1428,0.5714,1.1428,0"
                                        Background="{StaticResource BtnInnerHi}" />
                                <Border VerticalAlignment="Bottom" Height="0.5714" Margin="1.1428,0,1.1428,0.5714"
                                        Background="{StaticResource BtnInnerBottom}" />
                                <ContentPresenter x:Name="Content" Margin="2,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="HoverVeil" CornerRadius="0.5714" Background="#26FFFFFF"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverVeil" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0.5714" Y="0.5714" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="HoverVeil" Property="Background" Value="#33000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- big button -->
    <Style x:Key="BtnBig" TargetType="Button" BasedOn="{StaticResource MelodyButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnFillBig}" />
        <Setter Property="Foreground" Value="{StaticResource TextBig}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- small button -->
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource MelodyButtonBase}">
        <Setter Property="Background" Value="{StaticResource BtnFillSmall}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- text button -->
    <Style x:Key="BtnText" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource White89}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource White90}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0.5714" Y="0.5714" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
