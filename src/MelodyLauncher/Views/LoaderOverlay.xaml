<UserControl x:Class="MelodyLauncher.Views.LoaderOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="R" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/radio_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on.png" />
                                <Setter Property="Foreground" Value="#FF0000FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_off_hover.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- shadow rings -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />
        <!-- panel veil -->
        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M95,30 H673 V256 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="下载游戏" FontFamily="Microsoft YaHei"
                   FontSize="12" Foreground="#FF000000" />

        <!-- MC version -->
        <TextBlock Canvas.Left="32" Canvas.Top="46" Width="55" Height="24" Text="版本" Style="{StaticResource Lbl}" />
        <TextBlock x:Name="TextMcVersion" Canvas.Left="95" Canvas.Top="46" Width="560" Height="24"
                   FontFamily="Microsoft YaHei" FontSize="13" Foreground="#FF10222F" VerticalAlignment="Center" />

        <!-- loader type -->
        <TextBlock Canvas.Left="32" Canvas.Top="82" Width="60" Height="24" Text="安装类型" Style="{StaticResource Lbl}" />
        <RadioButton x:Name="RadioVanilla" Canvas.Left="95" Canvas.Top="82" Width="90" Height="24"
                     Content="原版" GroupName="LoaderGroup" IsChecked="True" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioForge" Canvas.Left="185" Canvas.Top="82" Width="90" Height="24"
                     Content="Forge" GroupName="LoaderGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioFabric" Canvas.Left="275" Canvas.Top="82" Width="90" Height="24"
                     Content="Fabric" GroupName="LoaderGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioNeoForge" Canvas.Left="365" Canvas.Top="82" Width="110" Height="24"
                     Content="NeoForge" GroupName="LoaderGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioOptiFine" Canvas.Left="475" Canvas.Top="82" Width="100" Height="24"
                     Content="OptiFine" GroupName="LoaderGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioLiteLoader" Canvas.Left="575" Canvas.Top="82" Width="100" Height="24"
                     Content="LiteLoader" GroupName="LoaderGroup" Style="{StaticResource R}" />

        <!-- instance name -->
        <TextBlock Canvas.Left="32" Canvas.Top="118" Width="60" Height="24" Text="实例名" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditName" Canvas.Left="95" Canvas.Top="118" Width="240" Height="24"
                 FontFamily="Microsoft YaHei" FontSize="12" VerticalContentAlignment="Center" Padding="4,0" />
        <TextBlock Canvas.Left="345" Canvas.Top="118" Width="320" Height="24"
                   Text="留空自动命名（如 1.20.1-Forge_47.2.0）"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center" />

        <!-- hint / status -->
        <TextBlock Canvas.Left="32" Canvas.Top="152" Width="600" Height="22"
                   Text="原版：只安装游戏本体；Forge/Fabric 等：安装到独立实例，不影响其它版本。"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center" />
        <TextBlock x:Name="TextStatus" Canvas.Left="32" Canvas.Top="180" Width="600" Height="26"
                   FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF10222F" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- buttons -->
        <Button x:Name="BtnStart" Canvas.Left="95" Canvas.Top="214" Width="110" Height="32" Content="开始下载"
                Style="{StaticResource BtnSmall}" FontSize="13" />
        <Button x:Name="BtnBack" Canvas.Left="215" Canvas.Top="214" Width="80" Height="32" Content="返回"
                Style="{StaticResource BtnSmall}" FontSize="13" />

        <!-- close -->
        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
