<UserControl x:Class="MelodyLauncher.Views.ResourceOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LblNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF173C44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Edit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E2B33" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF8C9AA3" />
            <Setter Property="BorderThickness" Value="0.5714" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0.5714">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/radio_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_off_hover.png" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on.png" />
                                <Setter Property="Foreground" Value="#FF0000FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on_hover.png" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 细进度条：白色凹槽 + 淡蓝填充 -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="Foreground" Value="#CC4E9BD1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#55808E96"
                                BorderThickness="0.5714" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <!-- panel fill: vertical gradient veil (alpha 0.58), radius 5.5, 1px border -->
        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- group box with title notch -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M95,30 H673 V256 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="社区资源" Style="{StaticResource Lbl}" FontSize="12" />

        <!-- 资源类型：五类 -->
        <RadioButton x:Name="RadioMod" Canvas.Left="32" Canvas.Top="45" Width="52" Height="22"
                     Content="Mod" GroupName="ResType" IsChecked="True" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioModpack" Canvas.Left="90" Canvas.Top="45" Width="70" Height="22"
                     Content="整合包" GroupName="ResType" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioResourcepack" Canvas.Left="164" Canvas.Top="45" Width="70" Height="22"
                     Content="资源包" GroupName="ResType" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioShader" Canvas.Left="238" Canvas.Top="45" Width="60" Height="22"
                     Content="光影" GroupName="ResType" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioDatapack" Canvas.Left="302" Canvas.Top="45" Width="72" Height="22"
                     Content="数据包" GroupName="ResType" Style="{StaticResource Radio}" />
        <TextBlock Canvas.Left="404" Canvas.Top="44" Width="272" Height="22"
                   Text="版本 / 加载器可留空 · 双击结果可下载" Style="{StaticResource LblNote}" TextAlignment="Right" />

        <!-- 搜索条件 -->
        <TextBlock Canvas.Left="32" Canvas.Top="72" Width="44" Height="24" Text="关键词" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditQuery" Canvas.Left="76" Canvas.Top="71" Width="180" Height="26"
                 Style="{StaticResource Edit}" ToolTip="要搜索的资源名称（支持中文，例如 钠 / 优化）" />
        <TextBlock Canvas.Left="268" Canvas.Top="72" Width="30" Height="24" Text="版本" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditVersion" Canvas.Left="298" Canvas.Top="71" Width="76" Height="26"
                 Style="{StaticResource Edit}" ToolTip="游戏版本，例如 1.20.1；留空表示不筛选" />
        <TextBlock Canvas.Left="386" Canvas.Top="72" Width="44" Height="24" Text="加载器" Style="{StaticResource Lbl}" />
        <ComboBox x:Name="ComboLoader" Canvas.Left="430" Canvas.Top="71" Width="94" Height="26"
                  FontFamily="Microsoft YaHei" FontSize="12"
                  ToolTip="仅对 Mod / 整合包生效；任意 = 不筛选" />
        <Button x:Name="BtnSearch" Canvas.Left="598" Canvas.Top="70" Width="78" Height="28" Content="搜索"
                Style="{StaticResource BtnSmall}" FontSize="12" ToolTip="按当前条件搜索社区资源" />

        <!-- 结果列表 -->
        <Border Canvas.Left="21" Canvas.Top="104" Width="656" Height="116" Background="#D9FFFFFF"
                BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ResultList" Margin="2" />
                </ScrollViewer>
                <TextBlock x:Name="TextEmpty" Text="输入关键词开始搜索；单击选中结果，双击直接下载到本地"
                           FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF5A6E78"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 操作区 + 状态栏 -->
        <Button x:Name="BtnDownload" Canvas.Left="21" Canvas.Top="224" Width="94" Height="28"
                Content="下载到本地" Style="{StaticResource BtnSmall}" FontSize="12"
                ToolTip="把选中结果下载到对应目录（Mod→mods，资源包→resourcepacks，光影→shaderpacks，数据包→datapacks，整合包→modpacks 并尝试安装）" />
        <Button x:Name="BtnOpenWebsite" Canvas.Left="121" Canvas.Top="224" Width="86" Height="28"
                Content="打开网页" Style="{StaticResource BtnSmall}" FontSize="12"
                ToolTip="在浏览器中打开选中结果的项目主页" />
        <Button x:Name="BtnOpenFolder" Canvas.Left="213" Canvas.Top="224" Width="86" Height="28"
                Content="打开目录" Style="{StaticResource BtnSmall}" FontSize="12"
                ToolTip="打开当前类型的本地目标目录" />
        <Button x:Name="BtnCancel" Canvas.Left="305" Canvas.Top="224" Width="80" Height="28"
                Content="取消下载" Style="{StaticResource BtnSmall}" FontSize="12" IsEnabled="False" />

        <ProgressBar x:Name="Progress" Canvas.Left="393" Canvas.Top="222" Width="283" Height="6"
                     Style="{StaticResource ThinBar}" Visibility="Collapsed" IsHitTestVisible="False" />
        <TextBlock x:Name="TextStatus" Canvas.Left="393" Canvas.Top="230" Width="283" Height="22"
                   Style="{StaticResource LblNote}" TextTrimming="CharacterEllipsis" ToolTip="" />

        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="关闭">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
