<UserControl x:Class="MelodyLauncher.Views.VersionSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LblNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF173C44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#FF0E2A3A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Edit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E2B33" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF8C9AA3" />
            <Setter Property="BorderThickness" Value="0.5714" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0.5714">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- self-drawn tab row: selected tab gets a white veil + bottom marker -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E3A46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bg" CornerRadius="2.5" Background="Transparent" Margin="0,1,0,1" />
                            <Border x:Name="Bar" Height="2" CornerRadius="1" Background="#FF1F6F8B" Opacity="0"
                                    VerticalAlignment="Bottom" Margin="8,0,8,0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#FF0B2E3F" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="PanelRoot">
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <!-- panel fill: vertical gradient veil (alpha 0.58), radius 5.5, 1px border -->
        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- left group box: installed version list -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M80,30 H184 V256 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="版本列表" Style="{StaticResource Lbl}" />

        <Border Canvas.Left="21" Canvas.Top="40" Width="156" Height="174" Background="#D9FFFFFF"
                BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ListVersions" Margin="2" />
            </ScrollViewer>
        </Border>
        <Button x:Name="BtnRefreshVersions" Canvas.Left="21" Canvas.Top="218" Width="156" Height="26"
                Content="刷新版本列表" Style="{StaticResource BtnSmall}" FontSize="12" />

        <!-- right group box: selected version detail tabs -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M300,30 H673 V256 H194 V30 H201" />
        <TextBlock Canvas.Left="206" Canvas.Top="22" Text="版本详情" Style="{StaticResource Lbl}" />
        <Path Stroke="#33173C44" StrokeThickness="0.5714" Data="M201,61 H667" />

        <RadioButton x:Name="TabOverview" Canvas.Left="204" Canvas.Top="38" Width="56" Height="22"
                     Content="概览" Tag="0" Style="{StaticResource Tab}" IsChecked="True" />
        <RadioButton x:Name="TabMod" Canvas.Left="262" Canvas.Top="38" Width="56" Height="22"
                     Content="Mod" Tag="1" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabResourcePacks" Canvas.Left="320" Canvas.Top="38" Width="56" Height="22"
                     Content="资源包" Tag="2" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabShaderPacks" Canvas.Left="378" Canvas.Top="38" Width="56" Height="22"
                     Content="光影" Tag="3" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabSaves" Canvas.Left="436" Canvas.Top="38" Width="56" Height="22"
                     Content="存档" Tag="4" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabScreenshots" Canvas.Left="494" Canvas.Top="38" Width="56" Height="22"
                     Content="截图" Tag="5" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabLog" Canvas.Left="552" Canvas.Top="38" Width="56" Height="22"
                     Content="日志" Tag="6" Style="{StaticResource Tab}" />
        <RadioButton x:Name="TabSettings" Canvas.Left="610" Canvas.Top="38" Width="56" Height="22"
                     Content="设置" Tag="7" Style="{StaticResource Tab}" />

        <Grid x:Name="PageHost" Canvas.Left="204" Canvas.Top="64" Width="464" Height="144">

            <!-- ======================= 概览 ======================= -->
            <Grid x:Name="PageOverview">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="版本目录" Style="{StaticResource Lbl}" />
                    <TextBlock x:Name="TextVersionPath" Grid.Column="1" Style="{StaticResource PathText}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="版本名称" Style="{StaticResource Lbl}" />
                    <TextBox x:Name="EditNewName" Grid.Column="1" Height="21.7" Style="{StaticResource Edit}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="BtnRenameVersion" Grid.Column="2" Height="24" Content="重命名"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnOpenVersionDir" Width="98" Height="24" Content="打开版本目录"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnOpenGameDir" Width="92" Height="24" Content="打开游戏目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnDeleteVersion" Width="82" Height="24" Content="删除版本" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                </StackPanel>

                <TextBlock x:Name="TextOverviewInfo" Grid.Row="3" FontFamily="Microsoft YaHei" FontSize="11"
                           Foreground="#FF173C44" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0" />
            </Grid>

            <!-- ======================= Mod ======================= -->
            <Grid x:Name="PageMod" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="BtnModScan" Width="66" Height="24" Content="扫描"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnModOpenDir" Width="106" Height="24" Content="打开 mods 目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock x:Name="TextModCount" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListMods" Margin="2" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnModEnable" Width="64" Height="24" Content="启用"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnModDisable" Width="64" Height="24" Content="禁用" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock Text="双击条目也可切换启用状态" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= 资源包 ======================= -->
            <Grid x:Name="PageResourcePacks" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextResourcePacksPath" Grid.Row="0" Style="{StaticResource PathText}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListResourcePacks" Margin="2" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnResourcePacksRefresh" Width="64" Height="24" Content="刷新"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnResourcePacksOpen" Width="96" Height="24" Content="打开目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock x:Name="TextResourcePacksCount" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= 光影 ======================= -->
            <Grid x:Name="PageShaderPacks" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextShaderPacksPath" Grid.Row="0" Style="{StaticResource PathText}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListShaderPacks" Margin="2" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnShaderPacksRefresh" Width="64" Height="24" Content="刷新"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnShaderPacksOpen" Width="96" Height="24" Content="打开目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock x:Name="TextShaderPacksCount" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= 存档 ======================= -->
            <Grid x:Name="PageSaves" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextSavesPath" Grid.Row="0" Style="{StaticResource PathText}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListSaves" Margin="2" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnSavesRefresh" Width="64" Height="24" Content="刷新"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnSavesOpen" Width="96" Height="24" Content="打开目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock x:Name="TextSavesCount" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= 截图 ======================= -->
            <Grid x:Name="PageScreenshots" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextScreenshotsPath" Grid.Row="0" Style="{StaticResource PathText}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ListScreenshots" Margin="2" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnScreenshotsRefresh" Width="64" Height="24" Content="刷新"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnScreenshotsOpen" Width="96" Height="24" Content="打开目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock x:Name="TextScreenshotsCount" Style="{StaticResource LblNote}" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= 日志 ======================= -->
            <Grid x:Name="PageLog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TextLogPath" Grid.Row="0" Style="{StaticResource PathText}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Border Grid.Row="1" Margin="0,2,0,0" Background="#D9FFFFFF"
                        BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
                    <TextBox x:Name="TextLogContent" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="10"
                             Foreground="#FF10222F" VerticalContentAlignment="Top"
                             Padding="4,3" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnLogRefresh" Width="56" Height="24" Content="刷新"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnLogCopy" Width="56" Height="24" Content="复制" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnLogOpen" Width="98" Height="24" Content="打开日志目录" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnCrashAnalyze" Width="82" Height="24" Content="崩溃分析" Margin="8,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- ======================= 设置（全局） ======================= -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="最大内存" Style="{StaticResource Lbl}" Width="64" />
                    <TextBox x:Name="EditMemory" Width="74" Height="21.7" Style="{StaticResource Edit}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="MB" Style="{StaticResource Lbl}" Width="34" Margin="4,0,0,0" />
                    <TextBlock Text="窗口" Style="{StaticResource Lbl}" Width="44" />
                    <TextBox x:Name="EditWinW" Width="52" Height="21.7" Style="{StaticResource Edit}"
                             VerticalAlignment="Center" ToolTip="游戏窗口宽度" />
                    <TextBlock Text="×" Style="{StaticResource Lbl}" Width="18" TextAlignment="Center" />
                    <TextBox x:Name="EditWinH" Width="52" Height="21.7" Style="{StaticResource Edit}"
                             VerticalAlignment="Center" ToolTip="游戏窗口高度" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="javaw 路径" Style="{StaticResource Lbl}" />
                    <TextBox x:Name="EditJava" Grid.Column="1" Height="21.7" Style="{StaticResource Edit}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="BtnBrowseJava" Grid.Column="2" Height="24" Content="浏览"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <Button x:Name="BtnFindJava" Grid.Column="3" Height="24" Content="查找 Java" Margin="6,0,0,0"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="BtnSaveGlobalSettings" Width="82" Height="24" Content="保存设置"
                            Style="{StaticResource BtnSmall}" FontSize="12" />
                    <TextBlock Text="全局设置：内存 / Java / 窗口尺寸对所有版本生效" Style="{StaticResource LblNote}"
                               Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="TextSettingsNote" Grid.Row="3" FontFamily="Microsoft YaHei" FontSize="11"
                           Foreground="#FF173C44" TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0"
                           Text="Java 路径留空时由引擎自动选择；内存建议 1024 MB 以上。窗口宽高为游戏窗口尺寸（像素）。" />
            </Grid>
        </Grid>

        <TextBlock x:Name="TextStatus" Canvas.Left="204" Canvas.Top="214" Width="464" Height="18"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44"
                   TextTrimming="CharacterEllipsis" />

        <!-- panel close -->
        <Button x:Name="BtnPanelClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
