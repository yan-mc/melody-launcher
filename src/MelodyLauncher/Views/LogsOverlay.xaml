<UserControl x:Class="MelodyLauncher.Views.LogsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Canvas>
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M95,30 H673 V256 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="运行日志" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF000000" />

        <TextBlock x:Name="TextLogPath" Canvas.Left="32" Canvas.Top="38" Width="430" FontFamily="Consolas"
                   FontSize="10" Foreground="#FF173C44" TextTrimming="CharacterEllipsis" />

        <Button x:Name="BtnRefresh" Canvas.Left="470" Canvas.Top="34" Width="66" Height="24" Content="刷新"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnOpenJobs" Canvas.Left="542" Canvas.Top="34" Width="66" Height="24" Content="任务目录"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnCopy" Canvas.Left="614" Canvas.Top="34" Width="54" Height="24" Content="复制"
                Style="{StaticResource BtnSmall}" FontSize="12" />

        <Border Canvas.Left="21" Canvas.Top="64" Width="656" Height="182" Background="#D9FFFFFF"
                BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="TextLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="11" Foreground="#FF10222F"
                         VerticalContentAlignment="Top" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
