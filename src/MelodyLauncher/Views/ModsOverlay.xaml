<UserControl x:Class="MelodyLauncher.Views.ModsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Canvas>
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M95,30 H673 V256 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="Mod 管理" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF000000" />

        <TextBlock Canvas.Left="32" Canvas.Top="44" Width="40" Height="24" Text="版本" FontFamily="Microsoft YaHei"
                   FontSize="12" Foreground="#FF000000" VerticalAlignment="Center" />
        <ComboBox x:Name="ComboVersion" Canvas.Left="72" Canvas.Top="44" Width="150" Height="24"
                  FontFamily="Microsoft YaHei" FontSize="12" />
        <Button x:Name="BtnScan" Canvas.Left="232" Canvas.Top="42" Width="70" Height="28" Content="扫描"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnOpenMods" Canvas.Left="308" Canvas.Top="42" Width="90" Height="28" Content="打开 Mods 目录"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <TextBlock x:Name="TextStatus" Canvas.Left="408" Canvas.Top="44" Width="250" Height="24"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center" />

        <Border Canvas.Left="21" Canvas.Top="78" Width="656" Height="150" Background="#D9FFFFFF"
                BorderBrush="#55808E96" BorderThickness="0.5714" CornerRadius="0.5714" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ModList" Margin="2" />
            </ScrollViewer>
        </Border>

        <Button x:Name="BtnEnable" Canvas.Left="21" Canvas.Top="234" Width="80" Height="26" Content="启用"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnDisable" Canvas.Left="109" Canvas.Top="234" Width="80" Height="26" Content="禁用"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnOpenGame" Canvas.Left="580" Canvas.Top="234" Width="96" Height="26" Content="打开游戏目录"
                Style="{StaticResource BtnSmall}" FontSize="12" />

        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
