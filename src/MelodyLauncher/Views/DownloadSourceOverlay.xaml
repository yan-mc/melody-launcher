<UserControl x:Class="MelodyLauncher.Views.DownloadSourceOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Edit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E2B33" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF8C9AA3" />
            <Setter Property="BorderThickness" Value="0.5714" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0.5714">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/radio_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on.png" />
                                <Setter Property="Foreground" Value="#FF0000FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_off_hover.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <!-- panel fill -->
        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- group boxes -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M95,30 H400 V210 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="下载源预设" FontFamily="Microsoft YaHei"
                   FontSize="12" Foreground="#FF000000" />
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M480,30 H673 V210 H422 V30 H429" />
        <TextBlock Canvas.Left="432" Canvas.Top="22" Text="API 配置" FontFamily="Microsoft YaHei"
                   FontSize="12" Foreground="#FF000000" />

        <!-- presets -->
        <RadioButton x:Name="RadioAuto" Canvas.Left="32" Canvas.Top="60" Width="180" Height="24"
                     Content="自动（内置，推荐）" GroupName="SrcMode" IsChecked="True" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioOfficial" Canvas.Left="32" Canvas.Top="90" Width="180" Height="24"
                     Content="Mojang 官方源" GroupName="SrcMode" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioMirror" Canvas.Left="32" Canvas.Top="120" Width="180" Height="24"
                     Content="BMCLAPI 镜像源" GroupName="SrcMode" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioCustom" Canvas.Left="32" Canvas.Top="150" Width="180" Height="24"
                     Content="自定义（下方配置）" GroupName="SrcMode" Style="{StaticResource Radio}" />
        <TextBlock x:Name="TextHint" Canvas.Left="32" Canvas.Top="182" Width="360" Height="24"
                   Text="优先级：自定义 &gt; 镜像 &gt; 官方；失败自动回退。" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center" />

        <!-- api config -->
        <TextBlock Canvas.Left="432" Canvas.Top="50" Width="60" Text="名称" FontFamily="Microsoft YaHei"
                   FontSize="12" Foreground="#000000" Height="24" VerticalAlignment="Center" />
        <TextBox x:Name="EditName" Canvas.Left="492" Canvas.Top="50" Width="176" Height="22" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="432" Canvas.Top="78" Width="240" Text="版本清单 URL（可空）" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44" />
        <TextBox x:Name="EditManifest" Canvas.Left="432" Canvas.Top="96" Width="236" Height="22" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="432" Canvas.Top="124" Width="240" Text="Mod 镜像（可空）" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44" />
        <TextBox x:Name="EditModMirror" Canvas.Left="432" Canvas.Top="142" Width="236" Height="22" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="432" Canvas.Top="170" Width="240" Text="URL 重写规则（每行 from = to）" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44" />
        <TextBox x:Name="EditRules" Canvas.Left="432" Canvas.Top="188" Width="236" Height="60"
                 Style="{StaticResource Edit}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />

        <!-- bottom buttons -->
        <Button x:Name="BtnTest" Canvas.Left="100" Canvas.Top="216" Width="90" Height="32" Content="测试连接"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnSave" Canvas.Left="200" Canvas.Top="216" Width="90" Height="32" Content="保存"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnReset" Canvas.Left="300" Canvas.Top="216" Width="90" Height="32" Content="恢复默认"
                Style="{StaticResource BtnSmall}" FontSize="12" />
        <TextBlock x:Name="TextStatus" Canvas.Left="100" Canvas.Top="249" Width="290" Height="16"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center" />

        <!-- close -->
        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
