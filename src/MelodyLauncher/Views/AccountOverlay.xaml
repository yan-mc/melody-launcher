<UserControl x:Class="MelodyLauncher.Views.AccountOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Edit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E2B33" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF8C9AA3" />
            <Setter Property="BorderThickness" Value="0.5714" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0.5714">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="5.5" BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- group boxes -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M80,30 H400 V210 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="账户" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF000000" />
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M480,30 H673 V210 H422 V30 H429" />
        <TextBlock Canvas.Left="432" Canvas.Top="22" Text="微软登录设置" FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF000000" />

        <!-- current account -->
        <TextBlock x:Name="TextState" Canvas.Left="32" Canvas.Top="48" Width="355" Height="24"
                   FontFamily="Microsoft YaHei" FontSize="13" Foreground="#FF10222F" VerticalAlignment="Center"
                   Text="未登录（当前使用离线登录）" />
        <TextBlock x:Name="TextName" Canvas.Left="32" Canvas.Top="78" Width="355" Height="24"
                   FontFamily="Microsoft YaHei" FontSize="12" Foreground="#FF17323D" VerticalAlignment="Center" />
        <TextBlock x:Name="TextUuid" Canvas.Left="32" Canvas.Top="104" Width="355" Height="24"
                   FontFamily="Consolas" FontSize="10" Foreground="#FF173C44" VerticalAlignment="Center" />
        <TextBlock Canvas.Left="32" Canvas.Top="132" Width="355" TextWrapping="Wrap"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44"
                   Text="登录成功后，启动游戏会自动使用微软正版账户（需在启动器设置里选对应版本）。" />

        <Button x:Name="BtnLogin" Canvas.Left="32" Canvas.Top="172" Width="110" Height="32" Content="微软登录"
                Style="{StaticResource BtnSmall}" FontSize="13" />
        <Button x:Name="BtnLogout" Canvas.Left="152" Canvas.Top="172" Width="90" Height="32" Content="退出登录"
                Style="{StaticResource BtnSmall}" FontSize="13" />

        <!-- client id config -->
        <TextBlock Canvas.Left="432" Canvas.Top="48" Width="230" Text="OAuth Client ID" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44" />
        <TextBox x:Name="EditClientId" Canvas.Left="432" Canvas.Top="64" Width="236" Height="24" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="432" Canvas.Top="94" Width="236" TextWrapping="Wrap" FontFamily="Microsoft YaHei"
                   FontSize="11" Foreground="#FF173C44"
                   Text="默认使用内置应用 ID。如登录提示应用不可用，可换成自己在 Azure 注册的应用（需允许公共客户端/设备代码流）。" />
        <Button x:Name="BtnSaveClient" Canvas.Left="432" Canvas.Top="172" Width="90" Height="32" Content="保存"
                Style="{StaticResource BtnSmall}" FontSize="13" />

        <!-- login progress / code -->
        <TextBlock x:Name="TextCode" Canvas.Left="32" Canvas.Top="216" Width="360" Height="30"
                   FontFamily="Consolas" FontSize="18" Foreground="#FF0A2F45" VerticalAlignment="Center" />
        <TextBlock x:Name="TextStatus" Canvas.Left="432" Canvas.Top="216" Width="236" Height="30"
                   FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF173C44" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- close -->
        <Button x:Name="BtnClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
