<UserControl x:Class="MelodyLauncher.Views.MessageOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="150"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Canvas>
        <!-- window -->
        <Border Width="320" Height="150" CornerRadius="0.5" BorderBrush="#FF6C8894" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFBCE1F0" Offset="0" />
                    <GradientStop Color="#FFF5FBFD" Offset="0.35" />
                    <GradientStop Color="#FFF5FBFD" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- title -->
        <TextBlock x:Name="TextTitle" Canvas.Left="9" Canvas.Top="6" Text="提示"
                   FontFamily="Microsoft YaHei" FontSize="14" Foreground="#FF000000" />
        <!-- body -->
        <TextBlock x:Name="TextBody" Canvas.Left="28" Canvas.Top="42" Width="264"
                   TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13" Foreground="#FF2B2C2C" />
        <!-- close -->
        <Button x:Name="BtnClose" Canvas.Left="292" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#B0FFFFFF" StrokeThickness="1.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- confirm button -->
        <Button x:Name="BtnConfirm" Canvas.Left="228.6" Canvas.Top="108" Width="69" Height="22" Content="确认"
                FontFamily="Microsoft YaHei" FontSize="14" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="#FFAAB4B8" BorderThickness="0.5714" CornerRadius="0.5714">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFE0EBEF" Offset="0" />
                                <GradientStop Color="#FFC7E3EE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Canvas>
</UserControl>
