<UserControl x:Class="MelodyLauncher.Views.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="698" Height="268"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LblNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF173C44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Edit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF1E2B33" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF8C9AA3" />
            <Setter Property="BorderThickness" Value="0.5714" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0.5714">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/radio_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_off_hover.png" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on.png" />
                                <Setter Property="Foreground" Value="#FF0000FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on_hover.png" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/checkbox_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/checkbox_off_hover.png" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/checkbox_on.png" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/checkbox_on_hover.png" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="PanelRoot">
        <!-- edge shadow rings: outside the panel only so the translucent veil is not darkened -->
        <Border Width="698" Height="268" CornerRadius="14" Margin="-10" BorderThickness="10"
                BorderBrush="#14000000" IsHitTestVisible="False" />
        <Border Width="698" Height="268" CornerRadius="10" Margin="-5" BorderThickness="5"
                BorderBrush="#1E000000" IsHitTestVisible="False" />

        <!-- panel fill: vertical gradient veil (alpha 0.58), radius 5.5, 1px border, shadow -->
        <Border x:Name="PanelFill" Width="698" Height="268" CornerRadius="5.5"
                BorderBrush="#63A5A1A1" BorderThickness="0.5714">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9474C2E5" Offset="0" />
                    <GradientStop Color="#94A6DAEF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Canvas x:Name="Content" Canvas.Left="3" Canvas.Top="2">
        <!-- group boxes with title notch -->
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M80,30 H400 V210 H15 V30 H22" />
        <TextBlock Canvas.Left="25" Canvas.Top="22" Text="游戏设置" Style="{StaticResource Lbl}" FontSize="12" />
        <Path Stroke="#45173C44" StrokeThickness="0.5714" Data="M480,30 H673 V210 H422 V30 H429" />
        <TextBlock Canvas.Left="432" Canvas.Top="22" Text="游戏管理" Style="{StaticResource Lbl}" FontSize="12" />

        <!-- left group -->
        <TextBlock Canvas.Left="32" Canvas.Top="60" Width="64" Height="24" Text="游戏名字" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditUser" Canvas.Left="94.7" Canvas.Top="60" Width="98.3" Height="21.7" Text="20020816" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="200" Canvas.Top="60" Width="64" Height="24" Text="密码" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditPass" Canvas.Left="234.7" Canvas.Top="60" Width="104.2" Height="21.7" Style="{StaticResource Edit}" />
        <CheckBox x:Name="CheckAuth" Canvas.Left="320" Canvas.Top="60" Width="100" Height="24" Content="正版登录" Style="{StaticResource Check}" />

        <TextBlock Canvas.Left="32" Canvas.Top="95" Width="64" Height="24" Text="最大内存" Style="{StaticResource Lbl}" />
        <RadioButton x:Name="RadioAutoMem" Canvas.Left="95" Canvas.Top="95" Width="100" Height="24" Content="自动设置" GroupName="MemGroup" IsChecked="True" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioManualMem" Canvas.Left="209" Canvas.Top="95" Width="90" Height="24" Content="手动" GroupName="MemGroup" Style="{StaticResource Radio}" />
        <TextBox x:Name="EditMemory" Canvas.Left="250.1" Canvas.Top="95" Width="48" Height="22.3" Text="1024" Style="{StaticResource Edit}" />
        <TextBlock Canvas.Left="310" Canvas.Top="95" Width="40" Height="24" Text="MB" Style="{StaticResource Lbl}" />

        <TextBlock Canvas.Left="32" Canvas.Top="130" Width="95" Height="24" Text="启动器皮肤" Style="{StaticResource Lbl}" />
        <RadioButton x:Name="RadioRandomSkin" Canvas.Left="96" Canvas.Top="130" Width="100" Height="24" Content="随机皮肤" GroupName="SkinGroup" IsChecked="True" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioDefaultSkin" Canvas.Left="199" Canvas.Top="130" Width="105" Height="24" Content="默认皮肤" GroupName="SkinGroup" Style="{StaticResource Radio}" />

        <TextBlock Canvas.Left="32" Canvas.Top="160" Width="80" Height="24" Text="java路径" Style="{StaticResource Lbl}" />
        <TextBox x:Name="EditJava" Canvas.Left="94.7" Canvas.Top="160" Width="218.3" Height="22.2" Style="{StaticResource Edit}" />
        <Button x:Name="BtnBrowseJava" Canvas.Left="330.1" Canvas.Top="159.9" Width="46.9" Height="25.1" Content="浏览" Style="{StaticResource BtnSmall}" FontSize="12" />

        <CheckBox x:Name="CheckDebug" Canvas.Left="20" Canvas.Top="214" Width="80" Height="24" Content="调试模式" Style="{StaticResource Check}" />
        <Button x:Name="BtnFindJava" Canvas.Left="99.9" Canvas.Top="214.7" Width="77.1" Height="32" Content="查找java" Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnTestAuth" Canvas.Left="199.9" Canvas.Top="214.7" Width="97.1" Height="32" Content="正版登录测试" Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnDeleteAuth" Canvas.Left="310.3" Canvas.Top="214.7" Width="97.1" Height="32" Content="删除正版信息" Style="{StaticResource BtnSmall}" FontSize="12" />

        <!-- right group -->
        <TextBlock Canvas.Left="430" Canvas.Top="50" Width="100" Height="25" Text="游戏列表" Style="{StaticResource Lbl}" />
        <ComboBox x:Name="ComboGameList" Canvas.Left="491.3" Canvas.Top="50.7" Width="176" Height="21.1"
                  FontFamily="Microsoft YaHei" FontSize="12" />
        <TextBlock Canvas.Left="430" Canvas.Top="82" Width="250" Text="游戏目录(Forge mods,材质包,存档的目录)" Style="{StaticResource LblNote}" />
        <RadioButton x:Name="RadioDirMc" Canvas.Left="430" Canvas.Top="105" Width="200" Height="24" Content="保存到 .minecraft" GroupName="DirGroup" IsChecked="True" Style="{StaticResource Radio}" />
        <RadioButton x:Name="RadioDirVersion" Canvas.Left="430" Canvas.Top="130" Width="245" Height="24" Content="保存到 .minecraft\versions\版本名称\" GroupName="DirGroup" Style="{StaticResource Radio}" />
        <TextBlock Canvas.Left="430" Canvas.Top="160" Width="160" Height="25" Text="只在1.6以上的版本有效" Style="{StaticResource LblNote}" />
        <Button x:Name="BtnRename" Canvas.Left="600.4" Canvas.Top="159.9" Width="66.9" Height="26.9" Content="重命名" Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnDeleteGame" Canvas.Left="460.6" Canvas.Top="214.7" Width="97.7" Height="32" Content="删除选中游戏" Style="{StaticResource BtnSmall}" FontSize="12" />
        <Button x:Name="BtnSaveSettings" Canvas.Left="600" Canvas.Top="214.7" Width="67.4" Height="32" Content="保存设置" Style="{StaticResource BtnSmall}" FontSize="12" />

        <!-- panel close -->
        <Button x:Name="BtnPanelClose" Canvas.Left="656" Canvas.Top="4" Width="22" Height="22"
                Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#F2FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        </Canvas>
    </Canvas>
</UserControl>
