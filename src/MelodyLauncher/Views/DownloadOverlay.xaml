<UserControl x:Class="MelodyLauncher.Views.DownloadOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720" Height="450"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF17323D" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF2A3238" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="R" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image x:Name="Gfx" Width="13.5" Height="13.5" Source="/Assets/ui/radio_off.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_on.png" />
                                <Setter Property="Foreground" Value="#FF0000FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gfx" Property="Source" Value="/Assets/ui/radio_off_hover.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- title bar: (6,6) 708x29 glass #74C1E1 58% + bottom bright line -->
        <Border Canvas.Left="6" Canvas.Top="6" Width="708" Height="29">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#9478C4E2" Offset="0" />
                    <GradientStop Color="#9472BFDD" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Rectangle Canvas.Left="6" Canvas.Top="34.4" Width="708" Height="0.5714" Fill="#4CFFFFFF" />

        <!-- page close (back to main) -->
        <Button x:Name="BtnPageClose" Canvas.Left="682" Canvas.Top="4" Width="24" Height="24"
                Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="返回主界面">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="#E6FFFFFF" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- list card: (19.4,35.4) 680x358 -->
        <Border Canvas.Left="19.4" Canvas.Top="35.4" Width="680" Height="358"
                Background="#EBF0F7FA" BorderBrush="#FFC8D2D8" BorderThickness="0.5714">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="19.4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0">
                    <TextBlock Text="版本" Style="{StaticResource HeadText}" Margin="5,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="名称" Style="{StaticResource HeadText}" Margin="56.6,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="简介" Style="{StaticResource HeadText}" Margin="154.6,0,0,0" HorizontalAlignment="Left" />
                    <Rectangle Width="0.5714" Fill="#FFA8B4BC" HorizontalAlignment="Left" Margin="69.1,0,0,0" />
                    <Rectangle Width="0.5714" Fill="#FFA8B4BC" HorizontalAlignment="Left" Margin="169.1,0,0,0" />
                    <Rectangle Height="0.5714" Fill="#FFA8B4BC" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="HeadStatus" Text="就绪" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontFamily="Microsoft YaHei" FontSize="11" Foreground="#FF10222F"
                               TextTrimming="CharacterEllipsis" MaxWidth="430" />
                </Grid>

                <!-- rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RowHost" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- bottom bar: (6,394) 708x48 grey glass 60% -->
        <Border Canvas.Left="6" Canvas.Top="394" Width="708" Height="48">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#999FA0A0" Offset="0" />
                    <GradientStop Color="#99797E80" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Rectangle Canvas.Left="6" Canvas.Top="394" Width="708" Height="0.5714" Fill="#38FFFFFF" />
        <Rectangle Canvas.Left="6" Canvas.Top="441.4" Width="708" Height="0.5714" Fill="#38FFFFFF" />

        <!-- category radios (引擎 同款) -->
        <RadioButton x:Name="RadioRelease" Canvas.Left="20" Canvas.Top="405" Width="80" Height="25"
                     Content="正式版" GroupName="DlGroup" IsChecked="True" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioSnapshot" Canvas.Left="90" Canvas.Top="405" Width="80" Height="25"
                     Content="预览版" GroupName="DlGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioOld" Canvas.Left="170" Canvas.Top="405" Width="80" Height="25"
                     Content="远古版" GroupName="DlGroup" Style="{StaticResource R}" />
        <RadioButton x:Name="RadioFool" Canvas.Left="230" Canvas.Top="405" Width="140" Height="25"
                     Content="愚人节版" GroupName="DlGroup" Style="{StaticResource R}" />

        <!-- actions -->
        <Button x:Name="BtnCommunity" Canvas.Left="490" Canvas.Top="402" Width="90" Height="35"
                Content="社区资源" Style="{StaticResource BtnSmall}" FontSize="13" />
        <Button x:Name="BtnDownload" Canvas.Left="600" Canvas.Top="402" Width="90" Height="35"
                Content="下载" Style="{StaticResource BtnSmall}" FontSize="13" />
    </Canvas>
</UserControl>
